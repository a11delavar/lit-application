{
	"repository": {
		"type": "git",
		"url": "git+https://github.com/a11delavar/lit-application.git"
	},
	"workspaces": [
		"./packages/*"
	],
	"type": "module",
	"author": "a11d",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/a11delavar/lit-application/issues"
	},
	"homepage": "https://github.com/a11delavar/lit-application#readme",
	"scripts": {
		"start": "vite demo",
		"demo:build": "vite build demo",
		"dev": "vitest --project chromium",
		"test": "vitest run",
		"lint": "eslint \"**/*.ts\"",
		"typescript": "node ./node_modules/typescript7/bin/tsc --build --noEmit && node ./node_modules/typescript7/bin/tsc -p packages/tsconfig.json && node ./node_modules/typescript7/bin/tsc -p demo/tsconfig.json",
		"build": "node ./node_modules/typescript7/bin/tsc --build",
		"clean": "node ./scripts/clean.ts",
		"bump": "node ./scripts/bump.ts",
		"peers": "node ./scripts/peers.ts",
		"release": "node ./scripts/release.ts",
		"changelog": "node ./scripts/changelog.ts",
		"readme": "node ./scripts/readme.ts"
	},
	"devDependencies": {
		"@3mo/commit-analyzer": "x",
		"@a11d/eslint-config": "x",
		"@lit/task": "1.x",
		"@types/node": "26.x",
		"@typescript-eslint/eslint-plugin": "x",
		"@typescript-eslint/parser": "x",
		"@vitest/browser-playwright": "5.x",
		"eslint": "x",
		"eslint-plugin-import": "x",
		"eslint-plugin-lit": "1.x",
		"execa": "x",
		"playwright": "1.x",
		"typescript": "6.x",
		"typescript7": "npm:typescript@7.x",
		"vite": "6.x",
		"vitest": "5.x"
	}
}
